# Production settings for the Oracle Cloud server.
#   cp deploy/env.production.example .env   (in the repo root on the server)
# NODE_ENV, MONGODB_URI, TRUST_PROXY, TURN_SERVER_URL and STUN_URLS are set by
# deploy/docker-compose.yml — don't add them here.

# Your free DuckDNS name (or any domain pointing at this server)
DOMAIN=duo-yourname.duckdns.org

# openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# The two people (passwords are asked for by ./deploy/duo.sh seed, not stored here)
AUTHORIZED_USER_1_EMAIL=
AUTHORIZED_USER_1_NAME=
AUTHORIZED_USER_2_EMAIL=
AUTHORIZED_USER_2_NAME=

# Media: Cloudinary recommended (converts iPhone videos for Android, delivers
# voice notes as MP3). Leave empty to store media on the server's disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=duo

# Web Push (copy from your local .env, or: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Self-hosted TURN (coturn) shared secret: openssl rand -hex 32
TURN_SHARED_SECRET=

# Sign-in alert emails (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
LOGIN_ALERT_ACCOUNTS=
LOGIN_ALERT_TO=
LOGIN_ALERT_MODE=both
LOGIN_ALERT_ONLINE_GAP_MINUTES=30
ALERT_TIME_ZONE=Asia/Kolkata

VITE_APP_NAME=Duo
