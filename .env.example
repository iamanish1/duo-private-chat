# ---------------------------------------------------------------------------
# Duo — environment configuration
# Copy to `.env` in the repository root. Never commit the real `.env`.
# The server reads every variable; the client only sees variables prefixed
# with VITE_ (and none of those are secrets).
# ---------------------------------------------------------------------------

# NODE_ENV is intentionally not set here: Vite reads this file too, and a
# NODE_ENV in it would make production client builds use React's dev build.
# The server defaults to development; set NODE_ENV=production on your host.
PORT=5000

# MongoDB connection string (Atlas, Docker, or `npm run db:local`)
MONGODB_URI=mongodb://127.0.0.1:27017/duo

# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# How long a device stays trusted for unlocking with the 4-digit Duo code
DEVICE_TOKEN_EXPIRES_IN=30d

# Origin(s) of the web client, comma-separated. Leave empty when the server
# serves the built client itself (recommended single-origin deployment).
CLIENT_URL=http://localhost:5173

# Cookie SameSite policy: lax (same-origin deploy) or none (client and API on
# different sites; requires HTTPS). Leave empty to auto-detect.
COOKIE_SAME_SITE=

# Number of reverse proxies in front of Express (Render/Railway/Nginx = 1)
TRUST_PROXY=0

# ---------------------------------------------------------------------------
# The two authorized people. Emails are the runtime allow-list; passwords are
# only read by `npm run seed` (min 8 characters) and are stored hashed.
# ---------------------------------------------------------------------------
AUTHORIZED_USER_1_EMAIL=
AUTHORIZED_USER_1_NAME=
AUTHORIZED_USER_1_PASSWORD=

AUTHORIZED_USER_2_EMAIL=
AUTHORIZED_USER_2_NAME=
AUTHORIZED_USER_2_PASSWORD=

# ---------------------------------------------------------------------------
# Media storage: "cloudinary" (production) or "local" (development only).
# Defaults to cloudinary when its credentials are present, otherwise local.
# ---------------------------------------------------------------------------
STORAGE_DRIVER=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=duo

MEDIA_MAX_IMAGE_MB=15
MEDIA_MAX_VIDEO_MB=100
MEDIA_MAX_VIDEO_SECONDS=300
MEDIA_MAX_VOICE_MB=15
MEDIA_MAX_VOICE_SECONDS=300
# Listen together: largest song file you can upload
MEDIA_MAX_SONG_MB=50

# ---------------------------------------------------------------------------
# Web Push (generate a key pair with `npm run vapid`)
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---------------------------------------------------------------------------
# WebRTC. STUN_URLS is comma-separated. For TURN, either set a static
# username/credential, or TURN_SHARED_SECRET (coturn `use-auth-secret`) to
# issue short-lived credentials per call.
# ---------------------------------------------------------------------------
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_SERVER_URL=
TURN_SERVER_USERNAME=
TURN_SERVER_CREDENTIAL=
TURN_SHARED_SECRET=
# Backup relays, offered after the one above. When a relay's free monthly
# allowance runs out it refuses new calls and phones use the next one.
TURN_BACKUP_URL=
TURN_BACKUP_USERNAME=
TURN_BACKUP_CREDENTIAL=
TURN_BACKUP2_URL=
TURN_BACKUP2_USERNAME=
TURN_BACKUP2_CREDENTIAL=
# Cloudflare Realtime TURN (1 TB/month free) — preferred when set; the TURN
# settings above are then used only as a fallback if Cloudflare is unreachable.
# Cloudflare dashboard → Realtime → TURN Server → Create: copy the Key ID and API token.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# ---------------------------------------------------------------------------
# Email (SMTP) — used for sign-in alerts. For Gmail: SMTP_HOST=smtp.gmail.com,
# SMTP_PORT=587, SMTP_USER=your Gmail address, SMTP_PASS=a 16-character App
# Password (Google Account → Security → 2-Step Verification → App passwords).
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Alternative for hosts that block SMTP (e.g. free Render): Brevo API key.
# When set, it is used instead of SMTP; EMAIL_FROM must be a verified sender.
BREVO_API_KEY=

# Sign-in alerts: email LOGIN_ALERT_TO when any account in LOGIN_ALERT_ACCOUNTS
# signs in (signin), opens the app after being away (online), or both.
LOGIN_ALERT_ACCOUNTS=
LOGIN_ALERT_TO=
LOGIN_ALERT_MODE=signin
LOGIN_ALERT_ONLINE_GAP_MINUTES=30
ALERT_TIME_ZONE=UTC

# ---------------------------------------------------------------------------
# Client (public, build-time). Only needed when the API lives on another
# origin than the client, e.g. https://api.example.com
# ---------------------------------------------------------------------------
VITE_API_URL=
VITE_APP_NAME=Duo
